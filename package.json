{
  "name": "harness",
  "version": "0.1.0",
  "description": "Declarative multi-role agent harness on top of opencode",
  "type": "module",
  "bin": {
    "harness": "./src/cli.ts"
  },
  "scripts": {
    "harness": "bun run src/cli.ts",
    "build": "bun build ./src/cli.ts --compile --outfile ./dist/harness",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.6.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/node": "^26.2.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
